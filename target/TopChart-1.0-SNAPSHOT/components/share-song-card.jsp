<div id="share-song-card-wrapper">

    <!-- CLASSIC 95 -->
    <div id="share-song-card-classic95"
         class="share-card song-share-card song-share-classic95">

        <div class="song-classic-window">
            <div class="song-classic-titlebar">
                <span>SONGINFO.EXE</span>
                <span>[x]</span>
            </div>

            <div class="song-classic-body">
                <div class="song-classic-chart-header">
                    <span name="share-song-chart-title"></span>
                    <span name="share-song-issue"></span>
                </div>

                <div class="song-classic-main">
                    <div class="song-classic-position">
                        <span name="share-song-position"></span>
                    </div>

                    <div class="song-classic-track">
                        <div class="song-classic-artist"
                             name="share-song-artist">
                        </div>

                        <div class="song-classic-title"
                             name="share-song-title">
                        </div>
                    </div>

                    <div class="song-classic-movement"
                         name="share-song-movement">
                    </div>
                </div>

                <div class="song-classic-date">
                    <span name="share-song-date-label">Chart date:</span>
                    <strong name="share-song-date"></strong>
                </div>

                <div class="song-classic-stats">
                    <div class="song-classic-stat">
                        <strong name="share-song-no1"></strong>
                        <span>weeks at No. 1</span>
                    </div>

                    <div class="song-classic-stat">
                        <strong name="share-song-top10"></strong>
                        <span>weeks in Top 10</span>
                    </div>

                    <div class="song-classic-stat">
                        <strong name="share-song-top20"></strong>
                        <span>weeks in Top 20</span>
                    </div>

                    <div class="song-classic-stat">
                        <strong name="share-song-top40"></strong>
                        <span>weeks in Top 40</span>
                    </div>
                </div>

                <div class="song-classic-footer">
                    <span>
                        chart by
                        <strong name="share-song-author"></strong>
                    </span>

                    <span>
                        Generated with TOP40 Chart Engine &copy; Egor Zimowski
                    </span>
                </div>
            </div>
        </div>
    </div>


    <!-- MAGAZINE -->
    <div id="share-song-card-magazine"
         class="share-card song-share-card song-share-magazine">

        <div class="song-magazine-label">
            SONG SPOTLIGHT
        </div>

        <div class="song-magazine-meta">
            <span name="share-song-chart-title"></span>

            <span name="share-song-meta-text"></span>
        </div>

        <div class="song-magazine-main">
            <div class="song-magazine-position">
                <span name="share-song-position"></span>
            </div>

            <div class="song-magazine-track">
                <div class="song-magazine-artist"
                     name="share-song-artist">
                </div>

                <div class="song-magazine-title"
                     name="share-song-title">
                </div>
            </div>

            <div class="song-magazine-movement"
                 name="share-song-movement">
            </div>
        </div>

        <div class="song-magazine-divider"></div>

        <div class="song-magazine-stats">
            <div class="song-magazine-stat">
                <strong name="share-song-no1"></strong>
                <span>No. 1</span>
            </div>

            <div class="song-magazine-stat">
                <strong name="share-song-top10"></strong>
                <span>Top 10</span>
            </div>

            <div class="song-magazine-stat">
                <strong name="share-song-top20"></strong>
                <span>Top 20</span>
            </div>

            <div class="song-magazine-stat">
                <strong name="share-song-top40"></strong>
                <span>Top 40</span>
            </div>
        </div>

        <div class="song-magazine-footer">
            <span>
                chart by
                <strong name="share-song-author"></strong>
            </span>

            <span>
                Generated with TOP40 Chart Engine &copy; Egor Zimowski
            </span>
        </div>
    </div>


    <!-- WINAMP -->
    <div id="share-song-card-winamp"
         class="share-card song-share-card song-share-winamp">

        <div class="song-winamp-window">
            <div class="song-winamp-titlebar">
                <span>TOP40 SONG PLAYER</span>
                <span>_ &#9633; x</span>
            </div>

            <div class="song-winamp-display">
                <div class="song-winamp-position"
                     name="share-song-position">
                </div>

                <div class="song-winamp-track">
                    <div class="song-winamp-artist"
                         name="share-song-artist">
                    </div>

                    <div class="song-winamp-title"
                         name="share-song-title">
                    </div>
                </div>

                <div class="song-winamp-movement"
                     name="share-song-movement">
                </div>
            </div>

            <div class="song-winamp-meta">
                <span name="share-song-chart-title"></span>

                <span name="share-song-meta-text"></span>
            </div>

            <div class="song-winamp-buttons">
                <span>&#9654;</span>
                <span>&#10074;&#10074;</span>
                <span>&#9632;</span>
                <span>&#9664;&#9664;</span>
                <span>&#9654;&#9654;</span>
            </div>

            <div class="song-winamp-stats">
                <div class="song-winamp-stat">
                    <span>NO. 1</span>
                    <strong name="share-song-no1"></strong>
                </div>

                <div class="song-winamp-stat">
                    <span>TOP 10</span>
                    <strong name="share-song-top10"></strong>
                </div>

                <div class="song-winamp-stat">
                    <span>TOP 20</span>
                    <strong name="share-song-top20"></strong>
                </div>

                <div class="song-winamp-stat">
                    <span>TOP 40</span>
                    <strong name="share-song-top40"></strong>
                </div>
            </div>

            <div class="song-winamp-footer">
                <span>
                    playlist by
                    <strong name="share-song-author"></strong>
                </span>

                <span>
                    Generated with TOP40 Chart Engine &copy; Egor Zimowski
                </span>
            </div>
        </div>
    </div>


    <!-- VINYL -->
    <div id="share-song-card-vinyl"
         class="share-card song-share-card song-share-vinyl">

        <div class="song-vinyl-record">
            <img src="${pageContext.request.contextPath}/images/share/vinyl.png"
                 alt=""
                 draggable="false">

            <div class="song-vinyl-label">
                <div class="song-vinyl-label-top">
                    TOP40
                </div>

                <div class="song-vinyl-label-artist"
                     name="share-song-artist">
                </div>

                <div class="song-vinyl-label-title"
                     name="share-song-title">
                </div>
            </div>
        </div>

        <div class="song-vinyl-info">
            <div class="song-vinyl-heading">
                VINYL SINGLE
            </div>

            <div class="song-vinyl-meta">
                <span name="share-song-chart-title"></span>

                <span name="share-song-meta-text"></span>
            </div>

            <div class="song-vinyl-main">
                <div class="song-vinyl-position"
                     name="share-song-position">
                </div>

                <div class="song-vinyl-track">
                    <div class="song-vinyl-artist"
                         name="share-song-artist">
                    </div>

                    <div class="song-vinyl-title"
                         name="share-song-title">
                    </div>
                </div>

                <div class="song-vinyl-movement"
                     name="share-song-movement">
                </div>
            </div>

            <div class="song-vinyl-stats">
                <div class="song-vinyl-stat">
                    <strong name="share-song-no1"></strong>
                    <span>weeks at No. 1</span>
                </div>

                <div class="song-vinyl-stat">
                    <strong name="share-song-top10"></strong>
                    <span>weeks in Top 10</span>
                </div>

                <div class="song-vinyl-stat">
                    <strong name="share-song-top20"></strong>
                    <span>weeks in Top 20</span>
                </div>

                <div class="song-vinyl-stat">
                    <strong name="share-song-top40"></strong>
                    <span>weeks in Top 40</span>
                </div>
            </div>

            <div class="song-vinyl-footer">
                <span>
                    curated by
                    <strong name="share-song-author"></strong>
                </span>

                <span>
                    Generated with TOP40 Chart Engine &copy; Egor Zimowski
                </span>
            </div>
        </div>
    </div>
</div>

<div id="share-song-modal" class="share-modal no-display">
    <div class="share-modal-window">
        <div class="share-titlebar">
            <span>Share song</span>
            <button type="button" name="share-song-close">x</button>
        </div>

        <div class="share-modal-body">
            <div class="share-template-grid">
                <label class="share-template-option">
                    <input type="radio"
                           name="share-song-template"
                           value="classic95"
                           checked>

                    <span class="share-template-title">Classic 95</span>
                    <span class="share-template-desc">
                        Windows-style song statistics card
                    </span>
                </label>

                <label class="share-template-option">
                    <input type="radio"
                           name="share-song-template"
                           value="magazine">

                    <span class="share-template-title">Magazine</span>
                    <span class="share-template-desc">
                        Editorial song spotlight
                    </span>
                </label>

                <label class="share-template-option">
                    <input type="radio"
                           name="share-song-template"
                           value="winamp">

                    <span class="share-template-title">Winamp-coded</span>
                    <span class="share-template-desc">
                        Classic audio player style
                    </span>
                </label>

                <label class="share-template-option">
                    <input type="radio"
                           name="share-song-template"
                           value="vinyl">

                    <span class="share-template-title">Vinyl single</span>
                    <span class="share-template-desc">
                        A collectible vinyl single
                    </span>
                </label>
            </div>

            <div class="share-modal-actions">
                <button type="button" name="share-song-download">
                    Download PNG
                </button>
            </div>
        </div>
    </div>
</div>