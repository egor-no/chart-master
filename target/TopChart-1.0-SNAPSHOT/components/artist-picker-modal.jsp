<div id="artist-picker-overlay" class="artist-picker-overlay no-display">
    <div id="artist-picker-modal" class="artist-picker-modal" role="dialog" aria-modal="true" aria-labelledby="artist-picker-title">
        <div class="artist-picker-titlebar">
            <span id="artist-picker-title">Select artist page</span>
            <button type="button" id="artist-picker-close" class="artist-picker-titlebar-close">&times;</button>
        </div>

        <div class="artist-picker-body">
            <div id="artist-picker-text" class="artist-picker-text">
                Choose where to go:
            </div>

            <div id="artist-picker-options" class="artist-picker-options"></div>

            <div class="artist-picker-actions">
                <button type="button" id="artist-picker-cancel">Cancel</button>
            </div>
        </div>
    </div>
</div>